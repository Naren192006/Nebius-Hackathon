# TrustRouter backend configuration.
# Copy to .env and fill in NEBIUS_API_KEY. NEVER commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# IDs from the Nebius Token Factory cookbook (Oct 2026). Run `python
# list_models.py` with a live key and copy the exact IDs here if they differ.
MODEL_NANO=nvidia/nvidia-nemotron-3-nano-30b-a3b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# USD per 1M tokens (Nebius Token Factory public list prices, Oct 2026).
PRICE_NANO_IN=0.06
PRICE_NANO_OUT=0.24
PRICE_SUPER_IN=0.30
PRICE_SUPER_OUT=0.90
PRICE_ULTRA_IN=1.00
PRICE_ULTRA_OUT=3.00

# Gateway defaults.
TRUSTROUTER_DB=./data/trustrouter.db
TRUSTROUTER_DEFAULT_MAX_TOKENS=512
TRUSTROUTER_REQUEST_TIMEOUT=60
# Estimated Tavily spend per verifier call (B can replace this with real cost).
TRUSTROUTER_VERIFY_COST_USD=0
# Vite dev origins allowed to call the gateway.
TRUSTROUTER_CORS_ORIGINS=http://localhost:5173
# 1 = deterministic local mock, no network/credits. Tests set this themselves.
TRUSTROUTER_MOCK_LLM=0
